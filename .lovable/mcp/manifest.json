{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://hyncpwfzvmxhftahpxxc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "fit-coach-hub",
      "version": "0.1.0",
      "title": "Fit Coach Hub"
    },
    "tools": [
      {
        "name": "get_my_summary",
        "title": "내 요약 정보",
        "description": "로그인한 사용자의 역할(회원/트레이너), 프로필, 남은 PT 횟수, 다음 예약을 한 번에 조회합니다.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_bookings",
        "title": "예약 목록 조회",
        "description": "접근 권한이 있는 예약을 조회합니다. 회원은 자신의 예약, 트레이너는 담당 예약만 보입니다. 범위(upcoming/past/all)와 상태로 필터링할 수 있습니다.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "scope": {
              "default": "upcoming",
              "description": "조회 범위",
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "all"
              ]
            },
            "status": {
              "description": "예약 상태 필터",
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "cancelled",
                "completed",
                "no_show"
              ]
            },
            "limit": {
              "default": 20,
              "description": "최대 개수",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_workout_logs",
        "title": "운동기록 조회",
        "description": "접근 권한이 있는 운동기록을 날짜 역순으로 조회합니다. 운동 종목, 무게, 횟수, 세트, 트레이너 피드백이 포함됩니다.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "member_id": {
              "description": "트레이너가 특정 회원의 기록만 볼 때 사용",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "default": 10,
              "description": "최대 기록 수",
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "request_booking",
        "title": "예약 신청",
        "description": "회원 본인 이름으로 담당 트레이너에게 예약을 신청합니다. 신청 상태(pending)로 접수되고 트레이너 승인 후 확정됩니다.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_at": {
              "type": "string",
              "description": "수업 시작 시각 (ISO 8601, 예: 2026-08-20T10:00:00Z)"
            },
            "note": {
              "description": "트레이너에게 남길 메모",
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "start_at"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_members",
        "title": "담당 회원 조회",
        "description": "트레이너가 담당하는 회원 목록과 각 회원의 남은 PT 횟수, 연락처, 목표를 조회합니다. 다른 트레이너의 회원은 포함되지 않습니다.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_booking_status",
        "title": "예약 상태 변경",
        "description": "트레이너가 담당 예약을 승인(confirmed), 취소(cancelled), 수업완료(completed), 노쇼(no_show)로 변경합니다. 다른 트레이너의 예약은 변경되지 않습니다.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "booking_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "변경할 예약 ID"
            },
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "cancelled",
                "completed",
                "no_show"
              ],
              "description": "변경할 상태"
            }
          },
          "required": [
            "booking_id",
            "status"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
